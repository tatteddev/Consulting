{
  "name": "consulting",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --import tsx --test tests/sites-worker.test.mjs",
    "start": "node --import tsx --env-file-if-exists=.env server/index.ts",
    "test:contact": "node --import tsx --test tests/contact.test.mjs tests/server.test.mjs",
    "test:cloudflare": "node --import tsx --test tests/cloudflare.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "dev:cloudflare": "wrangler dev",
    "check:secrets": "node scripts/check-secrets.mjs",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.25.12",
    "miniflare": "5.20261012.1-beta",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "6.4.4",
    "wrangler": "4.151.1"
  }
}
