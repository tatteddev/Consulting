{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oleg-consulting",
  "account_id": "32602ca412fd35c59329a93362cc5e60",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "olegnovoselskyy.com", "custom_domain": true },
    { "pattern": "www.olegnovoselskyy.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "CONTACT_ORIGIN": "https://olegnovoselskyy.com",
    "CONTACT_FROM_EMAIL": "Oleg Consulting <inquiries@mail.olegnovoselskyy.com>",
    "CONTACT_DAILY_CAP": "25",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFZcH6LR8RtHyKVy",
  },
  "durable_objects": {
    "bindings": [{ "name": "CONTACT_LIMITS", "class_name": "ContactLimits" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContactLimits"] }],
}
